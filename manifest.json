{
  "manifest_version": 3,
  "name": "No Tom",
  "version": "1.1",
  "description": "Ouça o YouTube no tom que você toca, sem alterar a velocidade.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.google.com/*"
      ],
      "js": [
        "conteudo.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "motor.js",
        "pagina.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.google.com/*"
      ]
    }
  ],
  "icons": {
    "48": "icone-48.png",
    "128": "icone-128.png"
  }
}
